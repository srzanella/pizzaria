# Copie para .env e preencha. O docker-compose lê este arquivo sozinho; o server.js também, quando roda fora do Docker.
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Equipe: senha do primeiro usuário "admin", criado na primeira subida (com a equipe vazia). Depois, troque na gestão.
# Sem ela, o servidor cria uma senha aleatória e grava em dados/senha-inicial-admin.txt.
ADMIN_SENHA_INICIAL=troque-por-uma-senha-longa

# Opcionais
# DATABASE_URL=postgres://pizzaria:SENHA@127.0.0.1:5433/pizzaria   (fora do Docker; padrão já é este)
# PG_POOL=10                                                        (conexões por instância do servidor)
# SITE_URL=https://pizzariapereira.com.br                           (endereço público para os links de acompanhamento)
# PROXY_CONFIAVEL=1                                                 (quantos proxies seus há na frente: Caddy, balanceador.
#                                                                    0 = nenhum, padrão: o X-Forwarded-For é ignorado)
# Servidor de produção: veja SERVIDOR.md (servidor/servidor.js gera um .env próprio em servidor/producao.env)

# Contas dos clientes
# CONTA_DIAS=180                                                    (quanto tempo o cliente fica conectado)
# O email do código e o "Continuar com Google" se configuram na gestão: Configurações → Email dos clientes / Login com Google.
# GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com             (padrão só enquanto a gestão não tiver nada salvo)
# CHAVE_SEGREDOS=uma-frase-longa-e-aleatoria                        (cifra a senha do email salva pela gestão; a mesma
#                                                                    em todas as instâncias; se trocar, digite a senha de novo)
# SMTP_URL=smtp://usuario:senha@smtp.seuprovedor.com:587            (padrão só enquanto a gestão não tiver email; smtps://…:465 para SSL)
# EMAIL_DE=Pizzaria Pereira <nao-responda@pizzariapereira.com.br>   (remetente desse padrão)

# App do entregador
# ENDERECO_REDE=http://192.168.1.13:8090                            (endereço que o celular usa; vai no QR e no APK)
# ANDROID_ASSINATURA_SENHA=…                                        (criada pelo android/gerar-apk.js; não perca)
